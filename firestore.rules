rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function phone() { return signedIn() ? request.auth.token.get('phone_number', '') : ''; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true || (
          exists(/databases/$(database)/documents/config/admin) && (
            request.auth.uid in get(/databases/$(database)/documents/config/admin).data.get('uids', []) ||
            (phone() != '' && phone() in get(/databases/$(database)/documents/config/admin).data.get('phones', []))
          )
        )
      );
    }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/config/staff) && (
        request.auth.uid in get(/databases/$(database)/documents/config/staff).data.get('uids', []) ||
        (phone() != '' && phone() in get(/databases/$(database)/documents/config/staff).data.get('phones', [])));
    }
    function staffPermissions() {
      return get(/databases/$(database)/documents/config/staff).data.get('permissionsByUid', {}).get(request.auth.uid,
        get(/databases/$(database)/documents/config/staff).data.get('permissionsByPhone', {}).get(phone(), {
          'dashboard': true, 'orders': true, 'cash': true, 'expenses': true,
          'schedule': false, 'staff': false, 'audit': false, 'appearance': false,
          'products': {'view': true, 'create': false, 'edit': false, 'delete': false},
          'categories': {'view': true, 'create': false, 'edit': false, 'delete': false}
        }));
    }
    function can(section) { return isAdmin() || (isStaff() && staffPermissions().get(section, false) == true); }
    function canEdit(section, action) {
      return isAdmin() || (isStaff() && staffPermissions().get(section, {}).get(action, false) == true);
    }
    function adminOrStaff() { return isAdmin() || isStaff(); }
    function ownsOrder(data) { return signedIn() && data.get('ownerId', '') == request.auth.uid; }
    function publicConfig(id) { return !(id in ['admin', 'staff', 'media']); }
    function mayWriteConfig(id) {
      return isAdmin() || (publicConfig(id) && (
        (id in ['hours', 'schedule', 'settings'] && can('schedule')) ||
        (id == 'billing' && (can('orders') || can('appearance'))) ||
        (id in ['theme', 'branding', 'payments', 'offer', 'featured', 'maintenance'] && can('appearance'))
      ));
    }
    // Validate only the stock-reserving transaction. Direct order creates remain public as requested.
    function validReservationOrder(o) {
      return o.keys().hasOnly([
        'ownerId', 'customer', 'customerPhone', 'items', 'productQuantities', 'total', 'itemCount', 'status',
        'paymentMethod', 'paymentGroup', 'paymentProofExpected', 'notes', 'deliveryType', 'deliveryAddress',
        'scheduledDate', 'scheduledTime', 'location', 'source', 'createdAt', 'updatedAt'
      ]) && o.customer is string && o.customer.size() > 0 && o.customer.size() <= 120
        && o.items is list && o.items.size() > 0 && o.items.size() <= 100
        && o.productQuantities is map && o.productQuantities.size() > 0 && o.productQuantities.size() <= 100
        && o.total is number && o.total >= 0 && o.total <= 10000000
        && o.itemCount is int && o.itemCount > 0 && o.itemCount <= 99900
        && o.status == 'pending' && o.paymentMethod in ['cash', 'card', 'yape', 'plin']
        && o.paymentProofExpected is bool && o.createdAt == request.time && o.updatedAt == request.time;
    }
    function linkedStockDecrease(productId) {
      let next = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(next.lastOrderId);
      return resource.data.get('active', true) != false
        && next.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId', 'stockReservations', 'updatedAt'])
        && resource.data.stock is int && next.stock is int && next.stock >= 0 && next.stock < resource.data.stock
        && next.lastOrderId is string && next.lastOrderId.size() > 5 && next.lastOrderId.size() <= 128
        && next.stockReservations is map
        && next.stockReservations.diff(resource.data.get('stockReservations', {})).affectedKeys().hasOnly([next.lastOrderId])
        && !(next.lastOrderId in resource.data.get('stockReservations', {}))
        && next.stockReservations.get(next.lastOrderId, 0) == resource.data.stock - next.stock
        && next.updatedAt == request.time && !exists(orderPath) && existsAfter(orderPath)
        && validReservationOrder(getAfter(orderPath).data)
        && getAfter(orderPath).data.productQuantities.get(productId, 0) == resource.data.stock - next.stock
        && getAfter(orderPath).data.productQuantities.get(productId, 0) <= 999;
    }
    function orderInventoryTransition(productId) {
      let next = request.resource.data;
      let id = next.lastOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(id);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let reserved = resource.data.get('stockReservations', {}).get(id, 0);
      let verified = reserved > 0 ? reserved : before.get('inventoryCommitted', {}).get(productId, 0);
      let qty = before.productQuantities.get(productId, 0);
      return can('orders') && before.status != after.status && next.updatedAt == request.time
        && next.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockReservations', 'lastOrderId', 'updatedAt'])
        && resource.data.stock is int && next.stock is int && next.stock >= 0
        && next.stockReservations is map
        && next.stockReservations.diff(resource.data.get('stockReservations', {})).affectedKeys().hasOnly([id])
        && (
          (after.status == 'rejected' && verified > 0 && next.stock == resource.data.stock + verified && !(id in next.stockReservations)) ||
          (after.status == 'done' && before.status != 'rejected' && next.stock == resource.data.stock && !(id in next.stockReservations)) ||
          (before.status == 'rejected' && after.status in ['pending', 'done'] && qty > 0 && qty <= 999 && next.stock == resource.data.stock - qty
            && (after.status == 'pending' ? next.stockReservations.get(id, 0) == qty : !(id in next.stockReservations))) ||
          (after.status == 'pending' && before.status == 'done' && verified > 0 && next.stock == resource.data.stock && next.stockReservations.get(id, 0) == verified)
        );
    }
    match /config/{id} {
      allow read: if publicConfig(id) || adminOrStaff();
      allow create, update: if mayWriteConfig(id);
      allow delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if canEdit('products', 'create');
      allow update: if canEdit('products', 'edit') || linkedStockDecrease(productId) || orderInventoryTransition(productId);
      allow delete: if canEdit('products', 'delete');
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if canEdit('categories', 'create');
      allow update: if canEdit('categories', 'edit');
      allow delete: if canEdit('categories', 'delete');
    }
    // Deliberately public: exposes orders and does NOT restrict writes to administrators.
    match /orders/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
    match /expenses/{id} { allow read: if can('expenses') || can('cash'); allow write: if can('expenses'); }
    match /blocked_clients/{id} {
      allow get: if signedIn();
      allow list, write: if can('orders');
    }
    match /media/{id} {
      allow read: if adminOrStaff();
      allow create, update: if (can('appearance') || canEdit('products', 'edit') || canEdit('products', 'create'))
        && request.resource.data.keys().hasOnly([
          'data', 'contentType', 'width', 'height', 'bytes', 'originalName', 'originalType', 'originalBytes',
          'kind', 'ownerId', 'createdAt', 'updatedAt', 'uploadedBy'
        ]) && request.resource.data.data is string && request.resource.data.data.matches('data:image/.*')
        && request.resource.data.data.size() > 100 && request.resource.data.data.size() <= 240000
        && request.resource.data.kind in ['product', 'logo'];
      allow delete: if can('appearance') || canEdit('products', 'delete') || canEdit('products', 'edit');
    }
    match /session_log/{id} {
      allow create: if adminOrStaff() && request.resource.data.keys().hasOnly([
        'uid', 'phone', 'loginAt', 'userAgent', 'platform', 'language', 'screenResolution'
      ]) && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
        && request.resource.data.get('phone', '') == phone()
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 1024;
      allow read: if can('audit');
      allow update, delete: if false;
    }
    match /chats/{chatId} {
      function chatOwner() { return signedIn() && chatId == request.auth.uid; }
      // A separate random 128-bit conversation link; it is never stored in public orders.
      // Anyone who obtains this link can access the conversation. Listing chats stays private.
      function localConversation() { return chatId.matches('chat-[a-f0-9]{32}'); }
      function localChatData() {
        return request.resource.data.ownerId == chatId
          && request.resource.data.keys().hasOnly(['ownerId', 'lastMessage', 'lastSender', 'updatedAt', 'unreadAdmin'])
          && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastSender == 'customer' && request.resource.data.updatedAt == request.time;
      }
      allow get: if can('orders') || chatOwner() || localConversation();
      allow list: if can('orders');
      allow create, update: if can('orders') || ((chatOwner() || localConversation()) && localChatData());
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if can('orders') || chatOwner() || localConversation();
        allow create: if can('orders') || ((chatOwner() || localConversation())
          && request.resource.data.keys().hasOnly(['text', 'sender', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000 && request.resource.data.sender == 'customer'
          && request.resource.data.createdAt == request.time);
        allow update, delete: if isAdmin();
      }
    }
    match /audit_log/{id} {
      allow create: if adminOrStaff();
      allow read: if can('audit');
      allow update, delete: if false;
    }
    match /paymentProofs/{orderId} {
      function linkedOrder() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
      // Customer can attach once to a pending order; existing files cannot be overwritten publicly.
      allow create: if (can('orders') || (linkedOrder().paymentProofExpected == true
        && linkedOrder().status == 'pending' && linkedOrder().paymentMethod == request.resource.data.paymentMethod))
        && request.resource.data.keys().hasOnly(['orderId', 'paymentMethod', 'imageData', 'fileName', 'contentType', 'originalType', 'encodedLength', 'createdAt'])
        && request.resource.data.orderId == orderId && request.resource.data.paymentMethod in ['card', 'yape', 'plin']
        && request.resource.data.imageData is string && request.resource.data.imageData.matches('data:image/.*')
        && request.resource.data.imageData.size() > 100 && request.resource.data.imageData.size() <= 420000
        && request.resource.data.encodedLength == request.resource.data.imageData.size()
        && request.resource.data.createdAt == request.time;
      allow read: if can('orders') || ownsOrder(linkedOrder());
      allow update, delete: if can('orders');
    }
    match /public_receipts/{token} {
      allow get: if can('orders') || (resource.data.billing.public == true && resource.data.status != 'rejected');
      allow list: if can('orders');
      allow create, update: if can('orders') && request.resource.data.keys().hasOnly([
        'orderId', 'status', 'items', 'total', 'paymentMethod', 'billing', 'createdAt'
      ]) && token.size() >= 32 && token == request.resource.data.billing.publicToken;
      allow delete: if can('orders');
    }
    match /{document=**} { allow read, write: if false; }
  }
}
